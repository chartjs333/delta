  "required": ["element_count", "element_start", "formal_semantics_id", "ordinal", "parameter_schema_id", "payload_sha256", "profile_id", "proof_instance_id", "round_config_id", "scale_table_id", "schema_version", "segment_id", "segment_offset", "shard_plan_id", "ticket_id", "type_name"],
