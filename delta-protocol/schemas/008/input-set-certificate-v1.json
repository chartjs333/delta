{
  "$id": "urn:deltareduce:schema:input-set-certificate:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formal_semantics_id": {
      "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "type_name": {
      "const": "INPUT_SET_CERTIFICATE"
    },
    "arithmetic_profile_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "height": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "parameter_schema_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "round_config_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "round_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "validator_epoch_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "view": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "input_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "quorum_threshold": {
      "maximum": 1024,
      "minimum": 1,
      "type": "integer"
    },
    "signer_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "tuples": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "availability_certificate_id": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "commitment_id": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "domain_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "ticket_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          }
        },
        "required": [
          "availability_certificate_id",
          "commitment_id",
          "domain_id",
          "ticket_id"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "arithmetic_profile_id",
    "formal_semantics_id",
    "height",
    "input_root",
    "parameter_schema_id",
    "quorum_threshold",
    "round_config_id",
    "round_id",
    "schema_version",
    "signer_ids",
    "tuples",
    "type_name",
    "validator_epoch_id",
    "view"
  ],
  "title": "DeltaReduce input-set-certificate v1",
  "type": "object"
}
