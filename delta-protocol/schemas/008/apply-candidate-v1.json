{
  "$id": "urn:deltareduce:schema:apply-candidate:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formal_semantics_id": {
      "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "type_name": {
      "const": "APPLY_CANDIDATE"
    },
    "arithmetic_profile_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "height": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "parameter_schema_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "round_config_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "round_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "validator_epoch_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "view": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "aggregate_root_qc_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "apply_arithmetic_profile_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "next_model_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "next_model_values": {
      "items": {
        "pattern": "^-?(0|[1-9][0-9]*)$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "next_optimizer_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "next_optimizer_values": {
      "items": {
        "pattern": "^-?(0|[1-9][0-9]*)$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "parent_checkpoint_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "parent_optimizer_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "aggregate_root_qc_id",
    "apply_arithmetic_profile_id",
    "arithmetic_profile_id",
    "formal_semantics_id",
    "height",
    "next_model_hash",
    "next_model_values",
    "next_optimizer_hash",
    "next_optimizer_values",
    "parameter_schema_id",
    "parent_checkpoint_id",
    "parent_optimizer_hash",
    "round_config_id",
    "round_id",
    "schema_version",
    "type_name",
    "validator_epoch_id",
    "view"
  ],
  "title": "DeltaReduce apply-candidate v1",
  "type": "object"
}
