{
  "$id": "urn:deltareduce:schema:eligibility-certificate:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formal_semantics_id": {
      "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "type_name": {
      "const": "ELIGIBILITY_CERTIFICATE"
    },
    "arithmetic_profile_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "height": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "parameter_schema_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "round_config_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "round_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "validator_epoch_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "view": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "domain_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "gamma": {
            "additionalProperties": false,
            "properties": {
              "denominator": {
                "maximum": 9007199254740991,
                "minimum": 1,
                "type": "integer"
              },
              "numerator": {
                "pattern": "^-?(0|[1-9][0-9]*)$",
                "type": "string"
              }
            },
            "required": [
              "denominator",
              "numerator"
            ],
            "type": "object"
          },
          "reason_code": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "ticket_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          }
        },
        "required": [
          "accepted",
          "domain_id",
          "gamma",
          "reason_code",
          "ticket_id"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "input_set_certificate_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "norm_evidence_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "quorum_threshold": {
      "maximum": 1024,
      "minimum": 1,
      "type": "integer"
    },
    "robust_profile_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "signer_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "arithmetic_profile_id",
    "entries",
    "formal_semantics_id",
    "height",
    "input_set_certificate_id",
    "norm_evidence_id",
    "parameter_schema_id",
    "quorum_threshold",
    "robust_profile_id",
    "round_config_id",
    "round_id",
    "schema_version",
    "signer_ids",
    "type_name",
    "validator_epoch_id",
    "view"
  ],
  "title": "DeltaReduce eligibility-certificate v1",
  "type": "object"
}
