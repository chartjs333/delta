  "required": [
    "aggregation_plan_certificate_id",
    "arithmetic_profile_id",
    "denominator",
    "domain_id",
    "eligibility_certificate_id",
    "formal_semantics_id",
    "height",
    "input_leaf_ids",
    "input_set_certificate_id",
    "parameter_schema_id",
    "quorum_threshold",
    "result_numerators",
    "round_config_id",
    "round_id",
    "schema_version",
    "shard_id",
    "signer_ids",
    "type_name",
    "validator_epoch_id",
    "view"
