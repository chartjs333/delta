      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "input_set_certificate_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "quorum_threshold": {
      "maximum": 1024,
      "minimum": 1,
      "type": "integer"
    },
    "result_numerators": {
      "items": {
        "pattern": "^-?(0|[1-9][0-9]*)$",
