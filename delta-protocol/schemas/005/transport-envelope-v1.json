{
  "$id": "urn:deltareduce:schema:transport-envelope:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "declared_payload_bytes": {
      "maximum": 1048576,
      "minimum": 0,
      "type": "integer"
    },
    "frame_type": {
      "enum": [
        "MANIFEST",
        "AVAILABILITY",
        "PIECE",
        "CANCEL"
      ]
    },
    "manifest_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ordinal": {
      "maximum": 8191,
      "minimum": 0,
      "type": "integer"
    },
    "project_id": {
      "minLength": 1,
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "type_name": {
      "const": "TRANSPORT_ENVELOPE"
    }
  },
  "required": [
    "declared_payload_bytes",
    "frame_type",
    "manifest_id",
    "ordinal",
    "project_id",
    "request_id",
    "schema_version",
    "type_name"
  ],
  "title": "DeltaReduce bounded transport envelope v1",
  "type": "object"
}
