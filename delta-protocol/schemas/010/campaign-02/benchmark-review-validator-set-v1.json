        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "campaign_id",
    "f_b",
    "formal_semantics_id",
    "purpose",
    "schema_version",
    "type_name",
    "validators"
