{
  "$id": "urn:deltareduce:schema:010:campaign-02:domain-manifest-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formal_semantics_id": {
      "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "type_name": {
      "const": "CAMPAIGN_DOMAIN_MANIFEST"
    },
    "campaign_id": {
      "const": "campaign-02"
    },
    "domains": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "denominator": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "domain_id": {
            "minLength": 1,
            "type": "string"
          },
          "numerator": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "ticket_count": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "dataset_id",
          "denominator",
          "domain_id",
          "numerator",
          "ticket_count"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "campaign_id",
    "domains",
    "formal_semantics_id",
    "schema_version",
    "type_name"
  ],
  "type": "object",
  "title": "DeltaReduce Feature 010 Campaign 02 domain-manifest-v1"
}
