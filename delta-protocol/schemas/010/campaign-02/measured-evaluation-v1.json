{
  "$id": "urn:deltareduce:schema:010:campaign-02:measured-evaluation-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formal_semantics_id": {
      "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "type_name": {
      "const": "MEASURED_EVALUATION"
    },
    "checkpoint_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "dataset_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "environment_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "evaluator_id": {
      "enum": [
        "hellaswag",
        "lambada",
        "wikitext"
      ]
    },
    "evaluator_implementation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "evaluator_profile_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "execution_plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "item_count": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "item_evidence_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "method_observation": {
      "minProperties": 1,
      "type": "object"
    },
    "metrics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "metric_id": {
            "minLength": 1,
            "type": "string"
          },
          "unit": {
            "minLength": 1,
            "type": "string"
          },
          "value": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "metric_id",
          "unit",
          "value"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "model_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "scored_token_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "source_class": {
      "const": "MEASURED_MODEL_INFERENCE"
    },
    "tokenizer_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "checkpoint_id",
    "dataset_id",
    "environment_id",
    "evaluator_id",
    "evaluator_implementation_id",
    "evaluator_profile_id",
    "execution_plan_id",
    "formal_semantics_id",
    "item_count",
    "item_evidence_root",
    "method_observation",
    "metrics",
    "model_id",
    "schema_version",
    "scored_token_count",
    "source_class",
    "tokenizer_id",
    "type_name"
  ],
  "type": "object",
  "title": "DeltaReduce Feature 010 Campaign 02 measured-evaluation-v1"
}
