{
  "$id": "urn:deltareduce:schema:010:campaign-02:ticket-plan-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formal_semantics_id": {
      "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "type_name": {
      "const": "CAMPAIGN_TICKET_PLAN"
    },
    "campaign_id": {
      "const": "campaign-02"
    },
    "domain_manifest_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "tickets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "domain_id": {
            "minLength": 1,
            "type": "string"
          },
          "optimizer_steps": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "ordinal": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "ticket_id": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "tokens_per_optimizer_step": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "tokens_per_ticket": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "domain_id",
          "optimizer_steps",
          "ordinal",
          "ticket_id",
          "tokens_per_optimizer_step",
          "tokens_per_ticket"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "workload_contract_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "domain_manifest_id",
    "formal_semantics_id",
    "schema_version",
    "tickets",
    "type_name",
    "workload_contract_id"
