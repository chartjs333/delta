{
  "$id": "urn:deltareduce:schema:010:campaign-02:plan-catalog-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formal_semantics_id": {
      "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
    },
    "schema_version": {
      "const": "3.0.0"
    },
    "type_name": {
      "const": "CAMPAIGN02_PLAN_CATALOG"
    },
    "base_plan_count": {
      "const": 15
    },
    "benchmark_definition_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "campaign_id": {
      "const": "campaign-02"
    },
    "definition_attestation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "definition_attestation_verified_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$",
      "type": "string"
    },
    "domain_manifest_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "execution_authorized": {
      "const": false
    },
    "gate_analyzer_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_ids": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 45,
      "minItems": 45,
      "type": "array",
      "uniqueItems": true
    },
    "plan_ids_by_stage": {
      "additionalProperties": false,
      "properties": {
        "STAGE_A_EXACTNESS": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 15,
          "minItems": 15,
          "type": "array",
          "uniqueItems": true
        },
        "STAGE_B_SCIENTIFIC": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 15,
          "minItems": 15,
          "type": "array",
          "uniqueItems": true
        },
        "STAGE_C_EMULATED_WAN": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 15,
          "minItems": 15,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "STAGE_A_EXACTNESS",
        "STAGE_B_SCIENTIFIC",
        "STAGE_C_EMULATED_WAN"
      ],
      "type": "object"
    },
    "qualified_runtime_lineage_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "stage_execution_identities_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "stage_execution_model": {
      "const": "INDEPENDENT_BFT_RUNS"
    },
    "status": {
      "const": "COMPILED_NOT_EXECUTABLE_REQUIRES_STAGE_AUTHORIZATION"
    },
    "ticket_identity_scope": {
      "const": "ROUND_ID_PLUS_TICKET_TEMPLATE_ID"
    },
    "ticket_plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "workload_contract_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "base_plan_count",
    "benchmark_definition_id",
    "campaign_id",
    "definition_attestation_id",
    "definition_attestation_verified_at",
    "domain_manifest_id",
    "execution_authorized",
    "formal_semantics_id",
    "gate_analyzer_id",
    "plan_ids",
    "plan_ids_by_stage",
    "qualified_runtime_lineage_id",
    "schema_version",
    "stage_execution_identities_id",
    "stage_execution_model",
    "status",
    "ticket_identity_scope",
    "ticket_plan_id",
    "type_name",
    "workload_contract_id"
  ],
  "type": "object",
  "title": "DeltaReduce Feature 010 Campaign 02 plan-catalog-v3"
}
