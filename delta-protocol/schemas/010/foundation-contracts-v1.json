        },
        "java_dependency_lock_id": {
          "$ref": "#/$defs/contentId"
        },
        "java_toolchain_id": {
          "$ref": "#/$defs/contentId"
        },
        "native_runtime_id": {
          "$ref": "#/$defs/contentId"
        },
        "netty_profile_id": {
          "$ref": "#/$defs/contentId"
        },
        "primary_eligible": {
          "const": false
        },
        "protocol_registry_id": {
          "$ref": "#/$defs/contentId"
        },
        "python_lock_id": {
          "$ref": "#/$defs/contentId"
        },
        "python_profile_id": {
          "$ref": "#/$defs/contentId"
        },
        "sbom_id": {
          "$ref": "#/$defs/contentId"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "source_commit": {
          "$ref": "#/$defs/gitId"
        },
        "source_tree": {
          "$ref": "#/$defs/gitId"
        },
        "type_name": {
          "const": "BENCHMARK_RUNTIME_IDENTITY"
        }
      }
    },
    "ScientificProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_scope",
        "dataset_id",
        "domain_tokens",
        "evaluator_ids",
        "evidence_class",
        "formal_semantics_id",
        "gate_eligible",
        "model_id",
        "model_mode",
        "optimizer_id",
        "primary_eligible",
        "repetitions",
        "schema_version",
        "seeds",
        "ticket_ids",
        "ticket_plan_id",
        "tokenizer_id",
        "total_eligible_tokens",
        "type_name"
      ],
      "properties": {
        "authority_scope": {
          "const": "BENCHMARK_GOVERNANCE_ONLY"
        },
        "dataset_id": {
          "$ref": "#/$defs/contentId"
        },
        "domain_tokens": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        },
        "evaluator_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        },
        "evidence_class": {
          "enum": [
            "FOUNDATION_ONLY",
            "TEST_FIXTURE"
          ]
        },
        "formal_semantics_id": {
          "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
        },
        "gate_eligible": {
          "const": false
        },
        "model_id": {
          "$ref": "#/$defs/contentId"
        },
        "model_mode": {
          "enum": [
            "FULL_MODEL",
            "QLORA_ADAPTER"
          ]
        },
        "optimizer_id": {
          "$ref": "#/$defs/contentId"
        },
        "primary_eligible": {
          "const": false
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "ticket_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        },
        "ticket_plan_id": {
          "$ref": "#/$defs/contentId"
        },
        "tokenizer_id": {
          "$ref": "#/$defs/contentId"
        },
        "total_eligible_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "type_name": {
          "const": "BENCHMARK_SCIENTIFIC_PROFILE"
        }
      }
    },
    "NetworkProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "authority_scope",
        "bandwidth_bytes_per_second",
        "disconnect_after_ms",
        "duplicate_ppm",
        "duration_ms",
        "evidence_class",
        "formal_semantics_id",
        "gate_eligible",
        "jitter_ms",
        "label",
        "loss_ppm",
        "partition_after_ms",
        "primary_eligible",
        "reorder_ppm",
        "rtt_ms",
        "schema_version",
        "seed",
        "type_name"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "UNPRIVILEGED_LOGICAL",
            "OPTIONAL_TC_NETEM"
          ]
        },
        "authority_scope": {
          "const": "BENCHMARK_GOVERNANCE_ONLY"
        },
        "bandwidth_bytes_per_second": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "disconnect_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "duplicate_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "evidence_class": {
          "enum": [
            "FOUNDATION_ONLY",
            "TEST_FIXTURE"
          ]
        },
        "formal_semantics_id": {
          "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
        },
        "gate_eligible": {
          "const": false
        },
        "jitter_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "label": {
          "const": "SIMULATED"
        },
        "loss_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "partition_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "primary_eligible": {
          "const": false
        },
        "reorder_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "rtt_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "type_name": {
          "const": "BENCHMARK_NETWORK_PROFILE"
        }
      }
    },
    "FaultProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_scope",
        "duration_ms",
        "events",
        "evidence_class",
        "formal_semantics_id",
        "gate_eligible",
        "label",
        "primary_eligible",
        "schema_version",
        "seed",
        "type_name"
      ],
      "properties": {
        "authority_scope": {
          "const": "BENCHMARK_GOVERNANCE_ONLY"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at_ms",
              "event_id",
              "expected_terminal",
              "kind",
              "target"
            ],
            "properties": {
              "at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "event_id": {
                "$ref": "#/$defs/identifier"
              },
              "expected_terminal": {
                "enum": [
                  "CONTINUE",
                  "SAFE_ABORT",
                  "RECOVER"
                ]
              },
              "kind": {
                "enum": [
                  "WORKER_CRASH",
                  "WORKER_RESTART",
                  "VALIDATOR_CRASH",
                  "VALIDATOR_RESTART",
                  "STORAGE_CRASH",
                  "STORAGE_RESTART",
                  "REGION_PARTITION",
                  "REGION_RESTORE",
                  "DISPERSED_CHURN",
                  "CONCENTRATED_CHURN"
                ]
              },
              "target": {
                "$ref": "#/$defs/identifier"
              }
            },
            "allOf": [
              {
                "if": {"properties": {"kind": {"enum": ["WORKER_CRASH", "VALIDATOR_CRASH", "STORAGE_CRASH", "DISPERSED_CHURN"]}}},
                "then": {"properties": {"expected_terminal": {"const": "CONTINUE"}}}
              },
              {
                "if": {"properties": {"kind": {"enum": ["WORKER_RESTART", "VALIDATOR_RESTART", "STORAGE_RESTART", "REGION_RESTORE"]}}},
                "then": {"properties": {"expected_terminal": {"const": "RECOVER"}}}
              },
              {
                "if": {"properties": {"kind": {"enum": ["REGION_PARTITION", "CONCENTRATED_CHURN"]}}},
                "then": {"properties": {"expected_terminal": {"const": "SAFE_ABORT"}}}
              }
            ]
          }
        },
        "evidence_class": {
          "enum": [
            "FOUNDATION_ONLY",
            "TEST_FIXTURE"
          ]
        },
        "formal_semantics_id": {
          "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
        },
        "gate_eligible": {
          "const": false
        },
        "label": {
          "const": "SIMULATED"
        },
        "primary_eligible": {
          "const": false
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "type_name": {
          "const": "BENCHMARK_FAULT_PROFILE"
        }
      }
    },
    "EnvironmentManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_scope",
        "binary_ids",
        "capture_epoch_ms",
        "dependency_lock_ids",
        "environment_variable_names",
        "evidence_class",
        "formal_semantics_id",
        "gate_eligible",
