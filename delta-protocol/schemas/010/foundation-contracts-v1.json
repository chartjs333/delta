          "const": "BENCHMARK_GOVERNANCE_ONLY"
        },
        "binary_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        },
        "capture_epoch_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "dependency_lock_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        },
        "environment_variable_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence_class": {
          "enum": [
            "FOUNDATION_ONLY",
            "TEST_FIXTURE"
          ]
        },
        "formal_semantics_id": {
          "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
        },
        "gate_eligible": {
          "const": false
