        "primary_eligible": {
          "const": false
        },
        "runtime_identity_id": {
          "$ref": "#/$defs/contentId"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scientific_profile_id": {
          "$ref": "#/$defs/contentId"
        },
        "type_name": {
          "const": "BENCHMARK_DEFINITION"
        },
        "approved_license_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        },
        "definition_reviewer_set_id": {
          "$ref": "#/$defs/contentId"
        },
        "result_evaluator_set_id": {
          "$ref": "#/$defs/contentId"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_policy",
        "availability",
        "content_id",
        "license_id",
        "locator",
        "name"
      ],
      "properties": {
        "content_id": {
          "$ref": "#/$defs/contentId"
        },
        "license_id": {
          "$ref": "#/$defs/contentId"
        },
        "locator": {
          "type": "string",
          "pattern": "^cas://sha256/[0-9a-f]{64}$"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "access_policy": {
          "enum": [
            "PUBLIC_FIXTURE",
            "RESTRICTED_LOCAL"
          ]
        },
        "availability": {
          "const": "VERIFIED_IMMUTABLE"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation",
        "direction",
        "mandatory",
        "metric_id",
        "missing_rule",
        "threshold"
      ],
      "properties": {
        "aggregation": {
          "enum": [
            "ALL",
            "MEAN",
            "MEDIAN",
            "P95",
            "P99"
          ]
        },
        "direction": {
          "enum": [
            "EXACT",
            "HIGHER",
            "LOWER"
          ]
        },
        "mandatory": {
          "type": "boolean"
        },
        "metric_id": {
          "$ref": "#/$defs/identifier"
        },
        "missing_rule": {
          "const": "FAIL"
        },
        "threshold": {
          "$ref": "#/$defs/rational"
        }
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denominator",
        "numerator"
      ],
      "properties": {
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "zeroTolerancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accept_stale",
        "adaptive_h",
        "consensus_arithmetic",
        "current_authority",
        "threshold_override"
      ],
      "properties": {
        "accept_stale": {
          "const": false
        },
        "adaptive_h": {
          "const": false
        },
        "consensus_arithmetic": {
          "const": "CHECKED_FIXED_POINT"
        },
        "current_authority": {
          "const": "NATIVE_RUNTIME"
        },
        "threshold_override": {
          "const": false
        }
      }
    },
