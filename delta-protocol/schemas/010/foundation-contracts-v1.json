{
  "$id": "https://deltareduce.org/schemas/010/foundation-contracts-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "phaseTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end_ns",
        "phase",
        "start_ns"
      ],
      "properties": {
        "end_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "phase": {
          "enum": [
            "compute",
            "upload",
            "availability",
            "certificate",
            "reduce",
            "apply",
            "p2p",
            "wait"
          ]
        },
        "start_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "baseProperties": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "formal_semantics_id": {
          "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
        },
        "authority_scope": {
          "const": "BENCHMARK_GOVERNANCE_ONLY"
        },
        "evidence_class": {
          "enum": [
            "FOUNDATION_ONLY",
            "TEST_FIXTURE"
          ]
        },
        "primary_eligible": {
          "const": false
        },
        "gate_eligible": {
          "const": false
        }
      }
    },
    "BenchmarkArm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "arm_kind",
        "authority_scope",
        "deployment_profile",
        "evidence_class",
        "formal_semantics_id",
        "gate_eligible",
        "model_mode",
        "primary_eligible",
        "schema_version",
        "topology",
        "type_name"
      ],
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/contentId"
        },
        "arm_kind": {
          "enum": [
            "REFERENCE",
            "DELTAREDUCE"
          ]
        },
        "authority_scope": {
          "const": "BENCHMARK_GOVERNANCE_ONLY"
        },
        "deployment_profile": {
          "enum": [
            "EMBEDDED_FFM",
            "ISOLATED_SIDECAR"
          ]
        },
        "evidence_class": {
          "enum": [
            "FOUNDATION_ONLY",
            "TEST_FIXTURE"
          ]
        },
        "formal_semantics_id": {
          "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
        },
        "gate_eligible": {
          "const": false
        },
        "model_mode": {
          "enum": [
            "FULL_MODEL",
            "QLORA_ADAPTER"
          ]
        },
        "primary_eligible": {
          "const": false
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "topology": {
          "enum": [
            "FLAT",
            "HIERARCHICAL"
          ]
        },
        "type_name": {
          "const": "BENCHMARK_ARM"
        }
      }
    },
    "BenchmarkDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "B",
        "H",
        "approved_license_ids",
        "arm_ids",
        "authority_scope",
        "decision_function",
        "definition_reviewer_set_id",
        "dependencies",
        "evidence_class",
        "fault_profile_ids",
        "formal_semantics_id",
        "gate_eligible",
        "metrics",
        "missing_run_policy",
        "network_profile_ids",
        "policy",
        "primary_eligible",
        "result_evaluator_set_id",
        "runtime_identity_id",
        "schema_version",
        "scientific_profile_id",
        "type_name"
      ],
      "properties": {
        "B": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "H": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "arm_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        },
        "authority_scope": {
          "const": "BENCHMARK_GOVERNANCE_ONLY"
        },
        "decision_function": {
          "const": "ALL_MANDATORY"
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "evidence_class": {
          "enum": [
            "FOUNDATION_ONLY",
            "TEST_FIXTURE"
          ]
        },
        "fault_profile_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        },
        "formal_semantics_id": {
          "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
        },
        "gate_eligible": {
          "const": false
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "missing_run_policy": {
          "const": "FAIL_CLOSED"
        },
        "network_profile_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        },
        "policy": {
          "$ref": "#/$defs/zeroTolerancePolicy"
