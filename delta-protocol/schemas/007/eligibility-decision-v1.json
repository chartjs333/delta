{
  "$id": "urn:deltareduce:schema:eligibility-decision:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formal_semantics_id": {
      "const": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "type_name": {
      "const": "ELIGIBILITY_DECISION"
    },
    "allowed_domain_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "capability_profile_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "decision_tick": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "eligibility_policy_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "eligible": {
      "type": "boolean"
    },
    "max_concurrent_leases": {
      "maximum": 1024,
      "minimum": 0,
      "type": "integer"
    },
    "reason_codes": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "region_route": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "round_config_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "worker_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    }
  },
  "required": [
    "allowed_domain_ids",
    "capability_profile_id",
    "decision_tick",
    "eligibility_policy_id",
    "eligible",
    "formal_semantics_id",
    "max_concurrent_leases",
    "reason_codes",
    "region_route",
    "round_config_id",
    "schema_version",
    "type_name",
    "worker_id"
  ],
  "title": "DeltaReduce eligibility-decision v1",
  "type": "object"
}
