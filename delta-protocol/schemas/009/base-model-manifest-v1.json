  "required": [
    "access_policy",
    "approved_ephemeral_caches",
    "config_hash",
    "formal_semantics_id",
    "license",
    "model_repository",
    "model_revision",
    "persistent_base_parameters",
    "persistent_protocol_buffers",
    "redistribution_allowed",
    "schema_version",
    "tokenizer_hash",
    "type_name",
