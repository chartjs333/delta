{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deltareduce:schema:tokenizer:1",
  "title": "DeltaReduce deterministic whitespace tokenizer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["pad_token", "schema_version", "unknown_token", "vocabulary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pad_token": {"type": "string", "minLength": 1},
    "unknown_token": {"type": "string", "minLength": 1},
    "vocabulary": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
