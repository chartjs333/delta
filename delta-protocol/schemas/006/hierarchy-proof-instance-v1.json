{
  "$id": "urn:deltareduce:schema:hierarchy-proof-instance:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accumulator_proof_instance_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "coefficient_abs_max": {
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "type": "string"
    },
    "coefficient_plan_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "common_denominator": {
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "type": "string"
    },
    "domain_ticket_counts": {
      "type": "object"
    },
    "final_abs_bound": {
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "type": "string"
    },
    "fixedpoint_config_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "formal_semantics_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "frozen_input_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "max_eligible_contributions": {
      "minimum": 1,
      "type": "integer"
    },
    "parent_checkpoint_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "product_abs_bound": {
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "q_abs_max": {
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "type": "string"
    },
    "result": {
      "const": "PASS"
    },
    "round_config_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "scale_table_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "selected_accumulator_width_bits": {
      "enum": [
        64,
        128
      ]
    },
    "shard_plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "shard_ranges": {
      "items": {
        "type": "array"
      },
      "minItems": 1,
      "type": "array"
    },
    "theorems": {
      "items": {
        "type": "object"
      },
      "minItems": 5,
      "type": "array"
    },
    "topology_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "type_name": {
      "const": "HIERARCHY_PROOF_INSTANCE"
    }
  },
  "required": [
    "accumulator_proof_instance_id",
    "coefficient_abs_max",
    "coefficient_plan_root",
    "common_denominator",
    "domain_ticket_counts",
    "final_abs_bound",
    "fixedpoint_config_id",
    "formal_semantics_id",
    "frozen_input_root",
    "max_eligible_contributions",
    "parent_checkpoint_id",
    "product_abs_bound",
    "profile_id",
    "q_abs_max",
    "result",
    "round_config_id",
    "scale_table_id",
    "schema_version",
    "selected_accumulator_width_bits",
    "shard_plan_id",
    "shard_ranges",
    "theorems",
    "topology_id",
    "type_name"
  ],
  "title": "DeltaReduce concrete hierarchy theorem-precondition instance v1",
  "type": "object"
}
