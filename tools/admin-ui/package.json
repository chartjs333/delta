{
  "name": "@deltareduce/admin-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:offline": "node scripts/check-offline-boundary.mjs",
    "audit:repository": "node scripts/check-repository-boundary.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "npm run typecheck && npm test && npm run build && npm run audit:offline",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "29.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
