        "manifest_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "ordinal": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "type": "string"
        },
        "previous_record_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
