{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deltareduce:schema:parameter-schema:1",
  "title": "DeltaReduce ParameterSchema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["frozen_omission_policy", "parameters", "schema_version", "tied_aliases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "frozen_omission_policy": {"enum": ["INCLUDE_ALL", "OMIT_FROZEN"]},
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_dtype", "name", "shape", "trainable"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,255}$"},
          "shape": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "logical_dtype": {"enum": ["bfloat16", "float16", "float32", "float64"]},
          "trainable": {"type": "boolean"}
        }
      }
    },
    "tied_aliases": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,255}$"},
      "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,255}$"}
    }
  }
}
