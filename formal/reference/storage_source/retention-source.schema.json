{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "T047/T053 scope13 future reference shape only. Duplicate members/canonical bytes and cross-field/authority relations are checked by retention.py, not by a post-parse JSON Schema. No old wire schema is extended.",
  "$ref": "#/$defs/source",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_ref",
        "retention_epoch_id",
        "schema_version",
        "type_name"
      ],
      "properties": {
        "obligation_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "byte_length",
            "sha256"
          ],
          "properties": {
            "byte_length": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "retention_epoch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "type_name": {
          "const": "STORAGE_RETENTION_POLICY_SOURCE"
        }
      }
    },
    "storage_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_epoch_id",
        "retention_policy_source",
        "storage_epoch_id",
        "storage_registry_id",
        "threshold"
      ],
      "properties": {
        "retention_epoch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "retention_policy_source": {
          "$ref": "#/$defs/source"
        },
        "storage_epoch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "storage_registry_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "threshold": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4]|4294967295)$"
        }
      }
    }
  }
}
