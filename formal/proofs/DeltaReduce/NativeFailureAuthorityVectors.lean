theorem abortParentsRead : readParents abortCandidate.parents = some abortParents := parentsRead abortParents
def abortEntry : AbortEntry := ⟨abortParents,abortCandidate.context,abortRow⟩
theorem abortCandidateChecked : checkAbort hash abortPolicy NativeConfigAdmissionVectors.state abortTail abortCandidate = some abortEntry := abortFromComponents ⟨abortParentsRead,abortContextExact,rfl,rfl,by decide,by decide,by decide⟩
