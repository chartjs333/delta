def hash (raw : Bytes) : Bytes := if raw = viewCtxPre then viewCtxHash else if raw = abortCtxPre then abortCtxHash else NativeFailureVectors.sha raw
theorem viewCtxSHA : hash viewCtxPre = viewCtxHash := by unfold hash; rw [if_pos rfl]
theorem viewContextExact : viewContext hash viewPolicy.round 0 = some viewCandidate.context := by unfold viewContext; rw [if_pos (by decide)]; unfold NativeStateBytes.contentId NativeStateBytes.contentPreimage; change (if (hash viewCtxPre).length = 32 then _ else _) = _; rw [viewCtxSHA]; rfl
theorem viewHashRetained : hash viewPreimage = viewHash := by unfold hash; rw [if_neg (by decide),if_neg (by decide)]; exact viewSHA
theorem viewBodyRetained : viewId hash view = some viewID := by simp only [viewId,NativeStateBytes.contentId,NativeStateBytes.contentPreimage,viewPreimageExact,viewHashRetained]; rfl
theorem viewRowRetained : checkRow NativePolicySchema.fmtViewChange readView (viewId hash) viewTree = some viewRow := rowFromComponents viewReadExact viewEncoded viewBodyRetained
theorem viewTailRetained : NativeFailureSection.checkTail hash viewPolicy NativeConfigAdmissionVectors.state = some viewTail := by
  apply NativeFailureSection.tailFromComponents; have h := NativeFailureSection.checkedTail viewTailChecked; refine ⟨h.lineage,h.timeoutTrees,h.timeouts,h.viewTrees,?_,h.requestTrees,h.requests,h.abortTrees,?_,h.valid⟩
  · simp only [checkViews,checkRows,viewTail,viewRowRetained,bind,Option.bind]
  · rfl
def viewParents : Parents := ⟨viewPolicy.config,abort.parent,[]⟩
theorem viewParentsRead : readParents viewCandidate.parents = some viewParents := parentsRead viewParents
def viewEntry : ViewEntry := ⟨viewParents,viewCandidate.context,viewRow,timeout⟩
theorem viewCandidateChecked : checkView hash viewPolicy NativeConfigAdmissionVectors.state viewTail viewCandidate = some viewEntry := viewFromComponents ⟨viewParentsRead,viewContextExact,rfl,rfl,rfl,by decide,by decide,by decide⟩
theorem abortCtxSHA : hash abortCtxPre = abortCtxHash := by unfold hash; rw [if_neg (by decide), if_pos rfl]
theorem abortContextExact : abortContext hash abortPolicy.round = some abortCandidate.context := by unfold abortContext; rw [if_pos (by decide)]; unfold NativeStateBytes.contentId NativeStateBytes.contentPreimage; change (if (hash abortCtxPre).length = 32 then _ else _) = _; rw [abortCtxSHA]; rfl
theorem abortHashRetained : hash abortPreimage = abortHash := by unfold hash; rw [if_neg (by decide),if_neg (by decide)]; exact abortSHA
theorem abortBodyRetained : abortId hash abort = some abortID := by simp only [abortId,NativeStateBytes.contentId,NativeStateBytes.contentPreimage,abortPreimageExact,abortHashRetained]; rfl
theorem abortRowRetained : checkRow NativePolicySchema.fmtAbortBody readAbort (abortId hash) abortTree = some abortRow := rowFromComponents abortReadExact abortEncoded abortBodyRetained
theorem abortTailRetained : NativeFailureSection.checkTail hash abortPolicy NativeConfigAdmissionVectors.state = some abortTail := by
  apply NativeFailureSection.tailFromComponents; have h := NativeFailureSection.checkedTail abortTailChecked; refine ⟨h.lineage,h.timeoutTrees,h.timeouts,h.viewTrees,?_,h.requestTrees,h.requests,h.abortTrees,?_,h.valid⟩
  · rfl
  · simp only [checkAborts,checkRows,abortTail,abortRowRetained,bind,Option.bind]
