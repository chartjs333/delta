    [iscResult] [iscId] [ecId] apc.common.accumulator [ecResult] [seedResult] apcTree = some
        apcResult :=
  NativePlanLineage.fromComponents ⟨rfl,apcParsed,by rfl,by rfl,by rfl,apcValid,by decide,apcHash⟩
