theorem contentFromHash {domain raw pre digest expected} (preimage : domain ++ [0] ++ raw = pre) (hashed : sha pre = digest) (size : digest.length = 32) (spelling : NativeVoteBytes.ascii "sha256:" ++ NativeVoteBytes.hexBytes digest = expected) : NativeStateBytes.contentId sha domain raw = some expected := by simp only [NativeStateBytes.contentId,NativeStateBytes.contentPreimage,preimage,hashed,size,ite_true,spelling]
