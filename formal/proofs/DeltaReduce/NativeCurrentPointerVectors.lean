theorem emptyCompleteLine : recover sha initial (.bytes [10]) = none := by decide
theorem crlfRejected : recover sha initial (.bytes (pre2 ++ [124] ++ NativeVoteBytes.hexBytes digest2 ++ [13,10])) = none := by decide
