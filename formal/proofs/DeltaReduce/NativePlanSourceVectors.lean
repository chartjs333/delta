theorem ecHash : NativeEligibility.id sha NativeEligibilityVectors.certificate = some NativeEligibilityVectors.qc := by

  unfold NativeEligibility.id NativeStateBytes.contentId

  rw [fallback (by decide) (by decide)]

  exact NativePlanVectors.ecHash

theorem apcHash : NativePlan.id sha NativePlanVectors.certificate = some NativePlanVectors.qc := by

  unfold NativePlan.id NativeStateBytes.contentId

  rw [fallback (by decide) (by decide)]

  exact NativePlanVectors.qcComputed


def context := NativePlanVectors.certificate.common.context
def committee := NativeIscCertificateVectors.committee

theorem iscChecked : NativeIscCertificate.check sha context committee
