{
  "schema_version": "1.0.0",
  "profile": "REMOTE_TLS",
  "protocol_id": "deltareduce.step5c.http.v1",
  "contract_schema_version": "1.0.0",
  "formal_semantics_id": "sha256:cc98f15ac20fc3ed265cb76682ca15a936e24660a651e2b8f81638abb3265cb6",
  "build_id_source": "required-cli-argument",
  "bindings": {
    "host": "0.0.0.0",
    "port": 8765,
    "allowed_origins": [
      "https://admin.example.invalid"
    ]
  },
  "limits": {
    "request_bytes": 10485760,
    "json_depth": 32,
    "request_timeout_seconds": 30,
    "max_inflight_requests": 16,
    "request_queue_size": 16,
    "worker_queue_capacity": 8,
    "worker_processes": 2,
    "shutdown_grace_seconds": 30
  },
  "identity": {
    "local_subject_id": "unused.remote-profile",
    "local_effective_roles": [
      "OPERATOR"
    ]
  },
  "remote_security": {
    "authentication": "BEARER_TOKEN",
    "remote_auth_config_file_env": "DELTA_REMOTE_AUTH_CONFIG",
    "tls_required": true,
    "tls_certificate_file_env": "DELTA_TLS_CERT_FILE",
    "tls_private_key_file_env": "DELTA_TLS_KEY_FILE",
    "controller_signing_key_file_env": "DELTA_SIGNING_KEY_FILE",
    "worker_trust_roots_file_env": "DELTA_WORKER_TRUST_ROOTS_FILE"
  },
  "components": {
    "controller": {
      "entrypoint": "delta-working-version",
      "role": "HTTPS_HOST_AND_AUTHORIZATION_GATE"
    },
    "worker": {
      "entrypoint": "delta-live-worker",
      "role": "CONSTRAINED_SUBPROCESS",
      "trust_roots": "EXPLICIT_RUNTIME_CONFIGURATION"
    },
    "admin_ui": {
      "artifact": "tools/admin-ui/dist-live",
      "role": "UNTRUSTED_LIVE_PRESENTATION"
    },
    "native_runtime": {
      "paths": [
        "delta-core-cpp",
        "delta-runtime-cpp",
        "delta-ffi"
      ],
      "mode": "REFERENCE_ONLY",
      "started": false,
      "semantic_claim": "NONE"
    },
    "jvm_node": {
      "path": "delta-node-java",
      "mode": "REFERENCE_ONLY",
      "started": false,
      "semantic_claim": "NONE"
    }
  }
}
