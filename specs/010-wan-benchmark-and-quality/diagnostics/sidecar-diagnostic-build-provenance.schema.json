{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deltareduce.example/schemas/feature010-sidecar-diagnostic-build-provenance-v1.1.json",
  "title": "Feature 010 sidecar diagnostic build provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "builder_container_image_digest",
    "execution",
    "invocation",
    "invocation_sha256",
    "outputs",
    "schema_version",
    "source",
    "source_checkout",
    "type_name"
  ],
  "properties": {
    "builder_container_image_digest": {"$ref": "#/$defs/contentId"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "stderr", "stdout"],
      "properties": {
        "exit_code": {"const": 0},
        "stderr": {"$ref": "#/$defs/executionStream"},
        "stdout": {"$ref": "#/$defs/executionStream"}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "environment", "environment_mode", "working_directory"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "environment": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "environment_mode": {"const": "REPLACE"},
        "working_directory": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "invocation_sha256": {"$ref": "#/$defs/contentId"},
    "outputs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/javaJar"},
        {"$ref": "#/$defs/nativeLibrary"},
        {"$ref": "#/$defs/sidecar"}
      ],
      "items": false
    },
    "schema_version": {"const": "1.1.0"},
    "source": {"$ref": "#/$defs/source"},
    "source_checkout": {"$ref": "#/$defs/sourceCheckout"},
    "type_name": {"const": "FEATURE010_SIDECAR_DIAGNOSTIC_BUILD_PROVENANCE"}
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\).+"
    },
    "contentId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "executionStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/contentId"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"type": "string"},
        "sha256": {"$ref": "#/$defs/contentId"}
      }
    },
    "javaJar": {
      "allOf": [
        {"$ref": "#/$defs/output"},
        {"properties": {"artifact_id": {"const": "JAVA_CLASSES_JAR"}}}
      ]
    },
    "nativeLibrary": {
      "allOf": [
        {"$ref": "#/$defs/output"},
        {"properties": {"artifact_id": {"const": "NATIVE_LIBRARY"}}}
      ]
    },
    "sidecar": {
      "allOf": [
        {"$ref": "#/$defs/output"},
        {"properties": {"artifact_id": {"const": "SIDECAR_EXECUTABLE"}}}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "repository", "tree"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "repository": {"const": "https://github.com/chartjs333/delta.git"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "sourceCheckout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkout_root", "commit", "git_invocations", "status_porcelain_sha256", "tree"],
      "properties": {
        "checkout_root": {"$ref": "#/$defs/absolutePath"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_invocations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/processReceipt"}
        },
        "status_porcelain_sha256": {"$ref": "#/$defs/contentId"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "processReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "environment",
        "environment_mode",
        "exit_code",
        "stderr_sha256",
        "stdout_sha256",
        "working_directory"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "environment": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "environment_mode": {"const": "REPLACE"},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "stderr_sha256": {"$ref": "#/$defs/contentId"},
        "stdout_sha256": {"$ref": "#/$defs/contentId"},
        "working_directory": {"$ref": "#/$defs/absolutePath"}
      }
    }
  }
}
