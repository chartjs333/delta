{
  "$id": "https://delta.local/schemas/step5c/admission-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "admission_expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "admission_id": {
      "format": "uuid",
      "type": "string"
    },
    "admitted_at": {
      "format": "date-time",
      "type": "string"
    },
    "authenticated_subject": {
      "additionalProperties": false,
      "properties": {
        "authenticated_via": {
          "enum": [
            "LOCAL_PEER_CREDENTIAL",
            "MTLS",
            "TOKEN"
          ],
          "type": "string"
        },
        "effective_roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subject_id": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "authenticated_via",
        "effective_roles"
      ],
      "type": "object"
    },
    "authenticator": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ED25519",
          "type": "string"
        },
        "issuer_id": {
          "maxLength": 128,
          "type": "string"
        },
        "key_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        },
        "signature": {
          "pattern": "^[0-9a-f]{128}$",
          "type": "string"
        }
      },
      "required": [
        "issuer_id",
        "key_id",
        "algorithm",
        "signature"
      ],
      "type": "object"
    },
    "execution_id": {
      "format": "uuid",
      "type": "string"
    },
    "intent_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "intent_id": {
      "format": "uuid",
      "type": "string"
    },
    "policy_context": {
      "additionalProperties": false,
      "properties": {
        "controller_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 64,
          "type": "string"
        },
        "verdict": {
          "const": "ADMITTED",
          "type": "string"
        }
      },
      "required": [
        "policy_version",
        "controller_commit",
        "verdict"
      ],
      "type": "object"
    },
    "resource_grants": {
      "additionalProperties": false,
      "properties": {
        "allow_downloads": {
          "type": "boolean"
        },
        "max_memory_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "timeout_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_memory_bytes",
        "timeout_seconds",
        "allow_downloads"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "admission_id",
    "intent_id",
    "intent_digest",
    "execution_id",
    "authenticated_subject",
    "policy_context",
    "resource_grants",
    "admitted_at",
    "admission_expires_at",
    "admission_digest",
    "authenticator"
  ],
  "title": "AdmissionRecord",
  "type": "object"
}
